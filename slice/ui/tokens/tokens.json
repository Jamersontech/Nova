{
  "$comment": [
    "NOVA design tokens -- the single source of truth (ADR 0041).",
    "Two tiers. `primitive` holds raw values and is the only place a literal appears.",
    "`semantic` references primitives by dotted path in {braces} and is what components consume.",
    "Components never read primitives directly: the indirection is what lets a palette change",
    "without touching a component, and what makes an unused or dangling token detectable.",
    "Generated output: tokens.css. Never hand-edit that file."
  ],
  "primitive": {
    "color": {
      "slate": {
        "950": "#080a0f",
        "900": "#10141c",
        "850": "#161b25",
        "800": "#1e2532",
        "700": "#2b3444",
        "500": "#5b6779",
        "300": "#9aa5b6",
        "100": "#dde3ec",
        "050": "#f4f7fb"
      },
      "accent": {
        "base": "#4f8cff",
        "strong": "#2f6ce0",
        "soft": "#1a2740"
      },
      "green": {
        "base": "#3fb87f",
        "soft": "#12281f"
      },
      "amber": {
        "base": "#e0a340",
        "soft": "#2c2213"
      },
      "red": {
        "base": "#e05a5a",
        "soft": "#2e1618"
      },
      "violet": {
        "base": "#9a7bff",
        "soft": "#211a33"
      }
    },
    "space": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.5rem",
      "6": "2rem",
      "8": "3rem"
    },
    "radius": {
      "none": "0",
      "sm": "4px",
      "md": "8px",
      "lg": "14px",
      "full": "999px"
    },
    "border": {
      "hair": "1px",
      "thick": "2px"
    },
    "type": {
      "family": {
        "sans": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
        "mono": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace"
      },
      "size": {
        "xs": "0.6875rem",
        "sm": "0.8125rem",
        "md": "0.9375rem",
        "lg": "1.125rem",
        "xl": "1.5rem"
      },
      "weight": {
        "regular": "400",
        "medium": "500",
        "semibold": "600"
      },
      "leading": {
        "tight": "1.2",
        "normal": "1.5",
        "relaxed": "1.7"
      },
      "tracking": {
        "normal": "0",
        "wide": "0.08em"
      }
    },
    "elevation": {
      "none": "none",
      "low": "0 1px 2px rgba(0,0,0,0.4)",
      "high": "0 8px 28px rgba(0,0,0,0.5)"
    },
    "motion": {
      "duration": {
        "instant": "0ms",
        "fast": "120ms",
        "normal": "220ms"
      },
      "ease": {
        "standard": "cubic-bezier(0.2, 0, 0.2, 1)"
      }
    },
    "size": {
      "$comment": "Pointer-target minimums. 24px is WCAG 2.5.8 (Minimum), AA.",
      "target-min": "24px",
      "target-comfortable": "44px"
    },
    "layout": {
      "$comment": "Grid track definitions. Structure, not decoration.",
      "split": "1fr 3fr",
      "stack": "1fr"
    }
  },
  "semantic": {
    "color": {
      "surface": {
        "base": "{color.slate.950}",
        "raised": "{color.slate.900}",
        "inset": "{color.slate.850}",
        "hover": "{color.slate.800}"
      },
      "border": {
        "subtle": "{color.slate.800}",
        "strong": "{color.slate.700}",
        "accent": "{color.accent.base}"
      },
      "text": {
        "primary": "{color.slate.050}",
        "secondary": "{color.slate.300}",
        "muted": "{color.slate.500}",
        "oncolor": "{color.slate.950}"
      },
      "accent": {
        "base": "{color.accent.base}",
        "strong": "{color.accent.strong}",
        "soft": "{color.accent.soft}"
      },
      "area": {
        "life": "{color.green.base}",
        "business": "{color.accent.base}",
        "wealth": "{color.violet.base}"
      },
      "risk": {
        "autonomous": "{color.green.base}",
        "contextual": "{color.amber.base}",
        "explicit": "{color.red.base}",
        "autonomous-soft": "{color.green.soft}",
        "contextual-soft": "{color.amber.soft}",
        "explicit-soft": "{color.red.soft}"
      },
      "stop": {
        "base": "{color.red.base}",
        "soft": "{color.red.soft}"
      }
    },
    "space": {
      "tight": "{space.2}",
      "snug": "{space.3}",
      "gutter": "{space.4}",
      "roomy": "{space.5}",
      "section": "{space.6}"
    },
    "radius": {
      "control": "{radius.sm}",
      "panel": "{radius.md}",
      "card": "{radius.lg}",
      "pill": "{radius.full}"
    },
    "border": {
      "width": "{border.hair}",
      "emphasis": "{border.thick}"
    },
    "type": {
      "family": {
        "ui": "{type.family.sans}",
        "code": "{type.family.mono}"
      },
      "size": {
        "caption": "{type.size.xs}",
        "body": "{type.size.sm}",
        "lead": "{type.size.md}",
        "title": "{type.size.lg}",
        "display": "{type.size.xl}"
      },
      "weight": {
        "normal": "{type.weight.regular}",
        "medium": "{type.weight.medium}",
        "strong": "{type.weight.semibold}"
      },
      "leading": {
        "tight": "{type.leading.tight}",
        "normal": "{type.leading.normal}"
      },
      "tracking": {
        "normal": "{type.tracking.normal}",
        "label": "{type.tracking.wide}"
      }
    },
    "elevation": {
      "flat": "{elevation.none}",
      "panel": "{elevation.low}",
      "modal": "{elevation.high}"
    },
    "motion": {
      "duration": "{motion.duration.fast}",
      "ease": "{motion.ease.standard}"
    },
    "control": {
      "target": "{size.target-min}"
    },
    "layout": {
      "columns": "{layout.split}"
    }
  },
  "responsive": {
    "$comment": [
      "Viewport-varying overrides for SEMANTIC tokens only (Section 17, ADR 0043 Proposed).",
      "",
      "Each band re-declares a semantic token inside a media query. Components are",
      "unchanged and unaware: they already read var(--nova-*), and the cascade picks",
      "the band. That is the whole mechanism -- no JavaScript computes layout, and no",
      "component knows a breakpoint exists.",
      "",
      "The breakpoint VALUES are a Section 17 implementation decision, not something",
      "the architecture dictates. WCAG 1.4.10 fixes a 320px test CONDITION; it does not",
      "mandate a scale. Two breakpoints are the minimum that yields the three bands the",
      "slice must demonstrate: mobile, tablet, desktop.",
      "",
      "Bands are emitted widest-first so the narrower one wins by source order."
    ],
    "breakpoints": {
      "mid": "1023px",
      "narrow": "599px"
    },
    "mid": {
      "layout.columns": "{layout.stack}",
      "space.section": "{space.5}"
    },
    "narrow": {
      "layout.columns": "{layout.stack}",
      "space.section": "{space.4}",
      "space.roomy": "{space.4}",
      "type.size.display": "{type.size.lg}",
      "type.size.title": "{type.size.md}"
    }
  }
}
